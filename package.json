{
  "name": "indocs",
  "private": true,
  "version": "0.1.0",
  "description": "AIエージェントが作ったHTMLを1か所に集めてPCとスマホから読むための自分専用サイト（Cloudflare版）",
  "license": "MIT",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @indocs/web dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "deploy": "pnpm --filter @indocs/web deploy"
  }
}
