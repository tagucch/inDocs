{
  "name": "@indocs/cli",
  "private": true,
  "version": "0.1.0",
  "description": "inDocs に HTML を登録し、インボックスとやり取りする CLI",
  "type": "module",
  "bin": {
    "indocs": "./dist/indocs.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
